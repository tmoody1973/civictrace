# CivicTrace non-secret local configuration template.
# Copy to .env locally; never commit real API keys, credentials, or service-account files.

GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
DEPLOY_ENV=dev

# Local Vertex AI (MOO-690; see docs/runbooks/local-vertex-setup.md). Non-secret.
# Auth comes from `gcloud auth application-default login`, never from a key file.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
CIVICTRACE_MODEL=gemini-flash-latest   # confirm the exact Flash id with the runbook smoke test

# Local application settings
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# Cost and worker guardrails
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=2
CLOUD_RUN_CPU=1
CLOUD_RUN_MEMORY=512Mi
TASK_MAX_CONCURRENT_DISPATCHES=2
TASK_MAX_RETRY_ATTEMPTS=3

# Model policy
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
ALLOW_PREMIUM_MODEL=false

# Data lifecycle defaults; revise when source/partner policy requires.
TEMP_ARTIFACT_RETENTION_DAYS=7
TRANSCRIPT_RETENTION_DAYS=30

# Future optional integrations: do not fill until approved and stored in Secret Manager for deployment.
# PARALLEL_API_KEY=
# TINYFISH_API_KEY=
